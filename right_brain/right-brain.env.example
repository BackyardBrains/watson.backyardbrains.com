# Copy to /etc/byb/right-brain.env. Read by right_brain/run.sh on every run.
#
# Which Claude model does the thinking. Use a full model id: the short names
# (opus, sonnet, haiku) can resolve to older models on this server.
# claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5, claude-fable-5-2
RIGHT_BRAIN_MODEL=claude-opus-5-5
# How hard it thinks: low, medium, high, xhigh, max.
RIGHT_BRAIN_EFFORT=high
# The run stops when its API-equivalent cost reaches this many dollars.
RIGHT_BRAIN_MAX_USD=8
# Set to 1 to rehearse: everything is read, nothing is written.
RIGHT_BRAIN_DRY_RUN=
